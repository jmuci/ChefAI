      "updated": 1762539720973,
      "link": null,
      "locked": false,
      "text": "API ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NIgbWY-_kzMJGC2E2OAzT",
      "type": "text",
      "x": 623.027402388994,
      "y": 325.6843280759847,
      "width": 557.1244737743114,
      "height": 1000,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGh",
      "roundness": null,
      "seed": 2047311930,
      "version": 2425,
      "versionNonce": 1317384768,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762801168252,
      "link": null,
      "locked": false,
      "text": "The BE will provide a HTML REST API using JSON for data\nExchange.\n\nEvery request requires user to be loged in, so they all include and Auth\nheader : Header : Bearer<Token>\n\n// Backend Sync Endpoint\n// Get changes, reconcile and post. Start by POSTING changes from\nthe outbox table, and then pull BE changes. \n\nGET /sync/pull?since={clientCheckpoint} \nSyncReqResponse(\n    changesetId:,\n\n)\n\nSyncChanges(\n    changedRecipes<Recipe>,\n    changedRecipeIngreidients<RecipeIngred>,\n    changedMealPlans<MealPlans>\n    deleted<DeletedEntityIds>\n} \nPOST /sync/push uploads\nChangeset(\n    reqId,  //idemp key\n    List<UpdatedRecipes>\n}\n\nPostChangesRequest(\n    reqId,\n    clientId,\n    changes<SyncChanges>\n)\n\nPostChangesResponse(\n    status,\n    lastChangeSetId,\n    conflicts<> // Returns conflicts if the server has a newer version\n(so the client can refetch).\n} \n\n\n\n\n\n\n\n\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The BE will provide a HTML REST API using JSON for data Exchange.\n\nEvery request requires user to be loged in, so they all include and Auth\nheader : Header : Bearer<Token>\n\n// Backend Sync Endpoint\n// Get changes, reconcile and post. Start by POSTING changes from the outbox table, and then pull BE changes. \n\nGET /sync/pull?since={clientCheckpoint} \nSyncReqResponse(\n    changesetId:,\n\n)\n\nSyncChanges(\n    changedRecipes<Recipe>,\n    changedRecipeIngreidients<RecipeIngred>,\n    changedMealPlans<MealPlans>\n    deleted<DeletedEntityIds>\n} \nPOST /sync/push uploads\nChangeset(\n    reqId,  //idemp key\n    List<UpdatedRecipes>\n}\n\nPostChangesRequest(\n    reqId,\n    clientId,\n    changes<SyncChanges>\n)\n\nPostChangesResponse(\n    status,\n    lastChangeSetId,\n    conflicts<> // Returns conflicts if the server has a newer version (so the client can refetch).\n} \n\n\n\n\n\n\n\n\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
