    {
      "id": "Ovu3lecjbSiE3r_wJ2-Yt",
      "type": "text",
      "x": -16.390625,
      "y": 269.15234375,
      "width": 177.93992614746094,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
