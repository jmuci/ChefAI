    {
      "id": "IwAjIiYa7xA2Nr3wM1zYN",
      "type": "text",
      "x": 645.1548878143313,
      "y": 1841.5792858575041,
      "width": 470.1796875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
