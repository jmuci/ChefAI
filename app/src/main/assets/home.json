      {
        "uuid": "dead0000-cafe-4000-8000-000000000101",
        "title": "Herb-Crusted Chicken",
        "description": "Juicy roasted chicken with a golden herb crust. A weeknight favourite.",
        "imageUrl": "https://images.chefai.app/recipes/herb-crusted-chicken.jpg",
        "imageUrlThumbnail": "https://images.chefai.app/recipes/thumb/herb-crusted-chicken.jpg",
        "prepTimeMinutes": 15,
        "cookTimeMinutes": 40,
        "servings": 4,
        "creatorId": "dead0000-cafe-4000-8000-000000000001",
        "privacy": "PUBLIC",
        "updatedAt": 1773792000000,
        "tagIds": [
          "dead0000-cafe-4000-8000-000000000016"
        ],
        "labelIds": [
          "dead0000-cafe-4000-8000-000000000020"
        ],
        "ingredients": [
          { "name": "Bone-in chicken breasts", "quantity": 4, "unit": "each" },
          { "name": "Breadcrumbs", "quantity": 1, "unit": "cup" },
          { "name": "Fresh parsley, chopped", "quantity": 2, "unit": "tbsp" },
          { "name": "Fresh rosemary, chopped", "quantity": 1, "unit": "tbsp" },
          { "name": "Garlic, minced", "quantity": 3, "unit": "cloves" },
          { "name": "Dijon mustard", "quantity": 2, "unit": "tbsp" },
          { "name": "Olive oil", "quantity": 3, "unit": "tbsp" },
          { "name": "Salt", "quantity": 1, "unit": "tsp" },
          { "name": "Black pepper", "quantity": 0.5, "unit": "tsp" }
        ],
        "steps": [
          { "orderIndex": 0, "instruction": "Preheat the oven to 200°C (400°F)." },
          { "orderIndex": 1, "instruction": "Mix the breadcrumbs, parsley, rosemary and garlic in a bowl." },
          { "orderIndex": 2, "instruction": "Brush the chicken breasts with Dijon mustard and olive oil, then season with salt and pepper." },
          { "orderIndex": 3, "instruction": "Press the herb breadcrumb mixture onto the top of each chicken breast." },
          { "orderIndex": 4, "instruction": "Roast for 35-40 minutes until the crust is golden and the chicken reaches 74°C (165°F) internally." },
          { "orderIndex": 5, "instruction": "Rest for 5 minutes before serving." }
        ]
      },
      {
        "uuid": "dead0000-cafe-4000-8000-000000000102",
        "title": "Mushroom Risotto",
        "description": "Creamy Arborio rice with wild mushrooms, white wine and Parmesan.",
        "imageUrl": "https://images.chefai.app/recipes/mushroom-risotto.jpg",
        "imageUrlThumbnail": "https://images.chefai.app/recipes/thumb/mushroom-risotto.jpg",
        "prepTimeMinutes": 10,
        "cookTimeMinutes": 30,
        "servings": 2,
        "creatorId": "dead0000-cafe-4000-8000-000000000001",
        "privacy": "PUBLIC",
        "updatedAt": 1773792000000,
        "tagIds": [
          "dead0000-cafe-4000-8000-000000000010",
          "dead0000-cafe-4000-8000-000000000015"
        ],
        "labelIds": [
          "dead0000-cafe-4000-8000-000000000021"
        ],
        "ingredients": [
          { "name": "Arborio rice", "quantity": 1, "unit": "cup" },
          { "name": "Mixed mushrooms, sliced", "quantity": 200, "unit": "g" },
          { "name": "Vegetable stock", "quantity": 750, "unit": "ml" },
          { "name": "White wine", "quantity": 120, "unit": "ml" },
          { "name": "Onion, finely chopped", "quantity": 1, "unit": "each" },
          { "name": "Garlic, minced", "quantity": 2, "unit": "cloves" },
          { "name": "Parmesan, grated", "quantity": 50, "unit": "g" },
          { "name": "Butter", "quantity": 2, "unit": "tbsp" },
          { "name": "Olive oil", "quantity": 1, "unit": "tbsp" }
        ],
        "steps": [
          { "orderIndex": 0, "instruction": "Warm the vegetable stock in a saucepan and keep it at a gentle simmer." },
          { "orderIndex": 1, "instruction": "Sauté the mushrooms in olive oil until golden, then set aside." },
          { "orderIndex": 2, "instruction": "In the same pan, cook the onion and garlic in butter until soft." },
          { "orderIndex": 3, "instruction": "Add the rice and stir for a minute, then pour in the white wine and let it absorb." },
          { "orderIndex": 4, "instruction": "Add the warm stock one ladle at a time, stirring until absorbed before adding more, about 18-20 minutes." },
          { "orderIndex": 5, "instruction": "Stir in the mushrooms and Parmesan, season to taste, and serve." }
        ]
      },
