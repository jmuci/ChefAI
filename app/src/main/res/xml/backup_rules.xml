<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 9-11 (API 28-30). data_extraction_rules.xml covers API 31+.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Re-downloadable recipe images cached from third-party CDNs — no reason to back these up. -->
    <exclude domain="file" path="recipe_images/"/>
    <!-- The recipe-import WebViews' profile: third-party page state, not the user's data. -->
    <exclude domain="root" path="app_webview/"/>
</full-backup-content>
