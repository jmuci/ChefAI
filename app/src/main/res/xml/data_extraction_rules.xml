<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12+ (API 31+). backup_rules.xml covers API 28-30.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Re-downloadable recipe images cached from third-party CDNs — no reason to back these up. -->
        <exclude domain="file" path="recipe_images/"/>
        <!--
            The recipe-import WebViews' profile (cookies, storage, service workers) holds state
            third-party pages set while being scraped. None of it is the user's data.
        -->
        <exclude domain="root" path="app_webview/"/>
    </cloud-backup>
    <!--
        Declared explicitly: with no section, device-to-device transfer copies everything,
        recipe_images/ and the WebView profile included.
    -->
    <device-transfer>
        <exclude domain="file" path="recipe_images/"/>
        <exclude domain="root" path="app_webview/"/>
    </device-transfer>
</data-extraction-rules>
